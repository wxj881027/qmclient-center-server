# QmClient Center Server 运行配置
# 复制为 .env 或写入 systemd EnvironmentFile。

PORT=8080

# token 与上报的时效参数
TOKEN_TTL_SEC=300
REPORT_TTL_SEC=90
TIME_SKEW_SEC=600
MAX_PLAYERS_PER_REPORT=8
MAX_SERVER_ADDRESS_LEN=128
RATE_LIMIT_PER_MIN=120

# 必须显式配置：未设置时服务每次启动都会随机生成，
# 重启后此前签发的 token 全部失效。
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET

# 仅在 nginx 等反向代理后面监听时才可开启
REQUIRE_IP_BIND=1
TRUST_PROXY=0

# 开发者名牌凭据文件（JSON，含 token_sha256，权限设为 600）
DEVELOPER_CREDENTIALS_FILE=/etc/qmclient/developer-credentials.json
# 允许发布新闻的开发者 ID，逗号分隔
NEWS_PUBLISH_DEVELOPER_IDS=

# 数据文件目录
PLAYTIME_DB_FILE=./playtime_db.json
TITLE_DATA_DIR=./title_data
NEWS_DATA_DIR=./news_data
NEWS_MAX_MARKDOWN_BYTES=16384

# 语音服务的实时通道
VOICE_REALTIME_URL=ws://127.0.0.1:9987/qm/realtime

# 客户端版本查询来源
CLIENT_RELEASE_OWNER=wxj881027
CLIENT_RELEASE_REPO=QmClient
CLIENT_LATEST_VERSION=2.36.0
CLIENT_VERSION_CACHE_TTL_SEC=300
CLIENT_VERSION_RETRY_DELAY_SEC=60
CLIENT_VERSION_FETCH_TIMEOUT_MS=5000

# 编辑器协作
EDITOR_COLLAB_MEMBER_TTL_SEC=45
EDITOR_COLLAB_ROOM_TTL_SEC=300
EDITOR_COLLAB_MAX_MAP_BASE64_LEN=25165824
