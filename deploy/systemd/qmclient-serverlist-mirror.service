[Unit]
Description=QmClient Server List Mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Q1menG_Client/tclient_scripts/qmclient_center_server
ExecStart=/usr/bin/node /home/ubuntu/Q1menG_Client/tclient_scripts/qmclient_center_server/serverlist_mirror_server.js
Environment=SERVERLIST_PORT=8081
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
